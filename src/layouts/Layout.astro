---
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Jpaez.dev | Juan David Paez Sierra - Full Stack Developer",
  description = "Portafolio de Juan David Paez Sierra, Desarrollador Full Stack enfocado en aplicaciones web y móviles."
} = Astro.props;
---

<!doctype html>
<html lang="es" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <ClientRouter />

    <!-- Script para persistir el tema claro/oscuro con ClientRouter de Astro -->
    <script is:inline>
      function applyTheme() {
        const storedTheme = localStorage.getItem('theme');
        const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
        const shouldBeDark = storedTheme === 'dark' || (!storedTheme && prefersDark);
        
        if (shouldBeDark) {
          document.documentElement.classList.add('dark');
        } else {
          document.documentElement.classList.remove('dark');
        }
      }

      applyTheme();
      // En Astro con ClientRouter, este evento se dispara tras cada navegación
      document.addEventListener('astro:after-swap', applyTheme);
    </script>
  </head>
  <body class="bg-[#FFFEFE]">
    <slot />
  </body>
</html>
