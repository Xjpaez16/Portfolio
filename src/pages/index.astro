---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Hero from '../components/Hero.astro';
import PageIndicator from '../components/PageIndicator.astro';
import FloatingControls from '../components/FloatingControls.astro';
---

<Layout title="Jpaez.dev | Juan David Paez Sierra">
  <!-- Navegación Superior -->
  <Navbar />

  <!-- Contenedor con scroll-snap vertical -->
  <main class="snap-y snap-mandatory h-screen overflow-y-scroll scroll-smooth">
    <section id="home" data-section class="snap-start flex items-center justify-center" style="min-height: calc(100dvh - 72px)">
      <Hero />
    </section>
    <section id="projects" data-section class="snap-start min-h-screen flex items-center justify-center">
      <!-- tu grid de proyectos -->
    </section>
    <section id="about"    data-section class="snap-start min-h-screen flex items-center justify-center">
      <!-- about -->
    </section>
    <section id="contact"  data-section class="snap-start min-h-screen flex items-center justify-center">
      <!-- contact -->
    </section>
  </main>

  <PageIndicator />
  <FloatingControls />
</Layout>

<style>
  @keyframes fadeIn {
    from {
      opacity: 0;
      transform: translateY(8px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .animate-fade-in {
    animation: fadeIn 0.5s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }
</style>
