---
// Componente Hero / Presentación Principal
---

<section class="flex flex-col md:flex-row items-center justify-center gap-8 md:gap-14 px-6 max-w-5xl mx-auto py-8">
  <!-- Avatar con borde gradiente estilo Instagram / Glow moderno -->
  <div class="relative group shrink-0">
    <div 
      class="p-[3.5px] rounded-full bg-linear-to-tr from-orange-500 via-rose-500 to-purple-600 shadow-xl transition-transform duration-300 group-hover:scale-[1.02]"
    >
      <div class="w-50 h-50 sm:w-48 sm:h-48 md:w-56 md:h-56 rounded-full overflow-hidden bg-white dark:bg-neutral-900">
        <img 
          src="/avatar.jpeg" 
          alt="Juan David Paez Sierra" 
          class="w-full h-full object-cover object-center"
          loading="eager"
        />
      </div>
    </div>
  </div>

  <!-- Contenido de presentación -->
  <div class="mt-6 md:mt-0 flex flex-col items-start text-left max-w-lg">
    <!-- Saludo -->
    <p class="text-base sm:text-lg text-neutral-600 dark:text-neutral-400 font-normal mb-3">
      ¡Hola! Soy <span class="text-neutral-900 dark:text-white font-medium">Juan David Paez Sierra.</span>
    </p>

    <!-- Bio destacada -->
    <h1 class="text-xl sm:text-2xl md:text-[1.65rem] leading-snug sm:leading-relaxed text-neutral-800 dark:text-neutral-200 font-normal mb-6">
      Soy Desarrollador <strong class="font-bold text-neutral-950 dark:text-white">Full Stack</strong> enfocado en <strong class="font-bold text-neutral-950 dark:text-white">aplicaciones web y móviles</strong>. Me apasiona aprender constantemente y colaborar en equipo para crear soluciones innovadoras.
    </h1>

    <!-- Botones de Redes Sociales -->
    <div class="flex items-center gap-3.5">
      <!-- GitHub Button -->
      <a 
        href="https://github.com/Xjpaez16" 
        target="_blank" 
        rel="noopener noreferrer"
        aria-label="Perfil de GitHub"
        class="group relative inline-flex items-center justify-center p-[1.5px] rounded-xl bg-linear-to-tr from-orange-500 via-rose-500 to-purple-600 hover:scale-105 active:scale-95 transition-all shadow-sm hover:shadow"
      >
        <div class="w-10 h-10 rounded-[10.5px] bg-white dark:bg-neutral-900 flex items-center justify-center transition-colors group-hover:bg-neutral-50 dark:group-hover:bg-neutral-800">
          <!-- Icono de GitHub -->
          <svg class="w-5 h-5 fill-current text-neutral-800 dark:text-neutral-200 group-hover:text-black dark:group-hover:text-white transition-colors" viewBox="0 0 24 24">
            <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"/>
          </svg>
        </div>
      </a>

      <!-- LinkedIn Button -->
      <a 
        href="https://www.linkedin.com/in/juan-david-paez-sierra-15380a253/" 
        target="_blank" 
        rel="noopener noreferrer"
        aria-label="Perfil de LinkedIn"
        class="group relative inline-flex items-center justify-center p-[1.5px] rounded-xl bg-linear-to-tr from-orange-500 via-rose-500 to-purple-600 hover:scale-105 active:scale-95 transition-all shadow-sm hover:shadow"
      >
        <div class="w-10 h-10 rounded-[10.5px] bg-white dark:bg-neutral-900 flex items-center justify-center transition-colors group-hover:bg-neutral-50 dark:group-hover:bg-neutral-800">
          <svg class="w-5 h-5 fill-current text-neutral-800 dark:text-neutral-200 group-hover:text-[#0A66C2] dark:group-hover:text-[#388dff] transition-colors" viewBox="0 0 24 24">
            <path d="M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h14m-.5 15.5v-5.3a3.26 3.26 0 0 0-3.26-3.26c-.85 0-1.84.52-2.28 1.3v-1.11h-2.79v8.37h2.79v-4.93c0-.77.62-1.4 1.39-1.4a1.4 1.4 0 0 1 1.4 1.4v4.93h2.75M6.46 10.9v8.37H9.2V10.9H6.46M7.83 6.25c-.96 0-1.74.78-1.74 1.74a1.74 1.74 0 0 0 1.74 1.74c.96 0 1.74-.78 1.74-1.74 0-.96-.78-1.74-1.74-1.74Z"/>
          </svg>
        </div>
      </a>
    </div>
  </div>
</section>

