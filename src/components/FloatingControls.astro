---
// Botones flotantes inferiores: Idioma y Modo Oscuro
---

<div 
  transition:persist="floating-controls"
  class="fixed bottom-6 md:bottom-10 left-6 md:left-12 flex items-center gap-3 z-30"
>
  <!-- Botón de Selección de Idioma -->
  <button
    id="lang-toggle-btn"
    type="button"
    aria-label="Cambiar idioma"
    class="w-12 h-12 rounded-full border border-neutral-300/80 dark:border-neutral-700/80 bg-white/80 dark:bg-neutral-800/80 backdrop-blur-sm flex items-center justify-center text-sm font-medium tracking-wide text-neutral-800 dark:text-neutral-200 hover:border-neutral-400 dark:hover:border-neutral-500 hover:scale-105 active:scale-95 transition-all shadow-sm cursor-pointer"
  >
    ES
  </button>

  <!-- Botón de Cambio de Tema (Día / Noche) -->
  <button
    id="theme-toggle-btn"
    type="button"
    aria-label="Alternar tema claro/oscuro"
    class="w-12 h-12 rounded-full border border-neutral-300/80 dark:border-neutral-700/80 bg-white/80 dark:bg-neutral-800/80 backdrop-blur-sm flex items-center justify-center text-neutral-800 dark:text-neutral-200 hover:border-neutral-400 dark:hover:border-neutral-500 hover:scale-105 active:scale-95 transition-all shadow-sm cursor-pointer"
  >
    <!-- Icono de Sol (visible en modo claro) -->
    <svg 
      class="w-5 h-5 block dark:hidden stroke-current" 
      viewBox="0 0 24 24" 
      fill="none" 
      stroke-width="2" 
      stroke-linecap="round" 
      stroke-linejoin="round"
    >
      <circle cx="12" cy="12" r="4"></circle>
      <path d="M12 2v2"></path>
      <path d="M12 20v2"></path>
      <path d="m4.93 4.93 1.41 1.41"></path>
      <path d="m17.66 17.66 1.41 1.41"></path>
      <path d="M2 12h2"></path>
      <path d="M20 12h2"></path>
      <path d="m6.34 17.66-1.41 1.41"></path>
      <path d="m19.07 4.93-1.41 1.41"></path>
    </svg>

    <!-- Icono de Luna (visible en modo oscuro) -->
    <svg 
      class="w-5 h-5 hidden dark:block stroke-current" 
      viewBox="0 0 24 24" 
      fill="none" 
      stroke-width="2" 
      stroke-linecap="round" 
      stroke-linejoin="round"
    >
      <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"></path>
    </svg>
  </button>
</div>

<script>
  function setupThemeToggle() {
    const btn = document.getElementById('theme-toggle-btn');
    if (!btn) return;

    btn.onclick = () => {
      const isDark = document.documentElement.classList.toggle('dark');
      localStorage.setItem('theme', isDark ? 'dark' : 'light');
    };
  }

  // Inicializar en primera carga y tras cada transición de Astro
  setupThemeToggle();
  document.addEventListener('astro:after-swap', setupThemeToggle);
</script>

