---
// Componente de navegación superior
const navItems = [
  { label: 'Projects', href: '/projects' },
  { label: 'About', href: '/about' },
  { label: 'Contact', href: '/contact' },
];
---

<header class="mt-8 w-full max-w-7xl mx-auto px-6 md:px-12 py-6 flex items-center justify-between z-20">
  <!-- Logo / Brand -->
  <a 
    href="/" 
    class="group relative inline-flex items-center p-1 text-xl font-semibold tracking-tight transition-all md:text-xl lg:text-2xl"
    aria-label="Ir al inicio"
  >
    <!-- Capa con efecto de resplandor / Glow en hover -->
    <div class="absolute -inset-1 rounded-2xl bg-linear-to-tr from-orange-500 via-rose-500 to-purple-600 opacity-0 blur-md transition-opacity duration-500 group-hover:opacity-75"></div>

    <!-- Contenedor principal con fondo (para que tape la luz del glow y solo se vea el borde/resplandor) -->
    <div class="relative flex items-center gap-2.5 rounded-xl bg-[#1F2933] dark:bg-neutral-900 px-3.5 py-1.5 ring-1 ring-white/10 dark:ring-neutral-700/60 shadow-sm transition-colors group-hover:ring-white/20">
      <!-- Puntos de color / Indicador activo -->
      <div class="h-2.5 w-2.5 rounded-full bg-orange-500 transition-transform duration-300 group-hover:scale-125 group-hover:bg-rose-500"></div>
      
      <!-- Texto del Logo -->
      <span class="text-white">Jpaez<span class="text-rose-500">.dev</span></span>
    </div>
  </a>

  <!-- Navigation Links -->
  <nav class="flex items-center gap-1 sm:gap-2 font-medium">
    {navItems.map((item) => (
      <a 
        href={item.href}
        class="rounded-full px-4 py-2 text-base md:text-lg text-neutral-700 dark:text-neutral-300 transition-all duration-200 hover:bg-orange-500/10 hover:text-orange-600 dark:hover:bg-orange-500/15 dark:hover:text-orange-400"
      >
        {item.label}
      </a>
    ))}
  </nav>
</header>

